{
  "name": "loupe",
  "productName": "Loupe",
  "version": "0.3.3",
  "description": "Screen capture, annotation and screen recording for the desktop.",
  "main": "main.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicklasklasson/loupe.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "postinstall": "node build/ensure-electron.js",
    "setup:electron": "node build/ensure-electron.js",
    "check:packaged": "node build/check-packaged.js dist/mac-universal/Loupe.app"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.loupe.capture",
    "productName": "Loupe",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "ocr.js",
      "src/**/*",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Loupe uses the microphone only when you turn it on for a screen recording.",
        "NSCameraUsageDescription": "Loupe shows your camera in a bubble only when you turn it on for a screen recording."
      },
      "x64ArchFiles": "**/node_modules/uiohook-napi/prebuilds/**"
    },
    "dmg": {
      "title": "Loupe"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Graphics"
    },
    "asar": false,
    "npmRebuild": false,
    "afterPack": "build/adhoc-sign.js"
  },
  "author": "Your team",
  "dependencies": {
    "mediabunny": "^1.60.0",
    "tesseract.js": "^7.0.0",
    "uiohook-napi": "^1.5.5"
  }
}
